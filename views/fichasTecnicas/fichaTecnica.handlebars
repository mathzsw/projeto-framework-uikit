<h1>Fichas Técnicas</h1>

<div class="uk-child-width-1-3@m uk-grid-small" uk-grid>
  {{#each fichasTecnicas}}
    <div>
      <div class="uk-card uk-card-default uk-card-body">
        <h3>Ficha Técnica #{{this.id}}</h3>

        {{#if this.filme}}
          <p>{{this.filme.titulo}}</p>
        {{/if}}

        <a href="#modal-{{this.id}}" class="uk-button uk-button-text" uk-toggle>
          Ver informações
        </a>

        <a href="/fichas-tecnicas/{{this.id}}" class="uk-margin-small-left">
          Ver detalhes
        </a>
      </div>

      <div id="modal-{{this.id}}" uk-modal>
        <div class="uk-modal-dialog uk-modal-body">
          <h2>Ficha Técnica #{{this.id}}</h2>

          {{#if this.filme}}
            <p><strong>Filme:</strong> {{this.filme.titulo}}</p>
          {{/if}}

          <p><strong>Duração:</strong> {{this.duracaoMinutos}} minutos</p>
          <p><strong>Orçamento:</strong> {{this.orcamento}}</p>
          <p><strong>Bilheteria:</strong> {{this.bilheteria}}</p>

          <button class="uk-modal-close-default" type="button" uk-close></button>
        </div>
      </div>
    </div>
  {{/each}}
</div>
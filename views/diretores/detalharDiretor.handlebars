<h1>{{diretor.nome}}</h1>

<p>
  <strong>Ano de nascimento:</strong>
  {{diretor.anoNascimento}}
</p>

<p>
  <strong>Nacionalidade:</strong>
  {{diretor.nacionalidade}}
</p>

<h2>Filmes</h2>

<ul>
  {{#each diretor.filmes}}
    <li>
      <a href="/filmes/{{this.id}}">
        {{this.titulo}} ({{this.ano}})
      </a>
    </li>
  {{/each}}
</ul>

<a href="/diretores">Voltar para diretores</a>
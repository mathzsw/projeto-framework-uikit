<h1>Artistas</h1>

{{#if mensagem}}
  <div class="uk-alert-success" uk-alert>
    <a href class="uk-alert-close" uk-close></a>
    <p>{{mensagem}}</p>
  </div>
{{/if}}

<a href="/artistas/cadastrar" class="uk-button uk-button-primary">
  Cadastrar novo artista
</a>

<div class="uk-child-width-1-3@m uk-grid-small" uk-grid>
  {{#each artistas}}
    <div>
      <div class="uk-card uk-card-default uk-card-body">
        <h3>{{this.nome}}</h3>

        <a href="#modal-{{this.id}}" class="uk-button uk-button-text" uk-toggle>
          Ver informações
        </a>
      </div>

      <div id="modal-{{this.id}}" uk-modal>
        <div class="uk-modal-dialog uk-modal-body">
          <h2>{{this.nome}}</h2>
          <p>Ano de nascimento: {{this.anoNascimento}}</p>
          <p>Nome artístico: {{this.nomeArtistico}}</p>

          <button class="uk-modal-close-default" type="button" uk-close></button>
        </div>
      </div>
    </div>
  {{/each}}
</div>

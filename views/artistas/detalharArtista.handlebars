<h1>{{artista.nome}}</h1>

<p><strong>Ano de nascimento:</strong> {{artista.anoNascimento}}</p>
<p><strong>Nome artístico:</strong> {{artista.nomeArtistico}}</p>

<h2>Filmes</h2>

<ul>
  {{#each artista.filmes}}
    <li>
      <a href="/filmes/{{this.id}}">
        {{this.titulo}} ({{this.ano}})
      </a>
    </li>
  {{/each}}
</ul>

<a href="/artistas">Voltar para artistas</a>
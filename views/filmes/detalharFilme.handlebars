<h1>{{filme.titulo}} ({{filme.ano}})</h1>

<p>
  <strong>Diretor:</strong>

  {{#if filme.diretor}}
    <a href="/diretores/{{filme.diretor.id}}">
      {{filme.diretor.nome}}
    </a>
  {{else}}
    Não informado
  {{/if}}
</p>

<h2>Elenco</h2>

<ul>
  {{#each filme.artistas}}
    <li>
      <a href="/artistas/{{this.id}}">
        {{this.nome}}
      </a>
    </li>
  {{/each}}
</ul>

{{#if filme.fichaTecnica}}
  <button class="uk-button uk-button-primary" uk-toggle="target: #modal-ficha">
    Ver ficha técnica completa
  </button>

  <div id="modal-ficha" uk-modal>
    <div class="uk-modal-dialog uk-modal-body">
      <h2 class="uk-modal-title">Ficha Técnica</h2>

      <p><strong>Duração:</strong> {{filme.fichaTecnica.duracaoMinutos}} minutos</p>
      <p><strong>Orçamento:</strong> {{filme.fichaTecnica.orcamento}}</p>
      <p><strong>Bilheteria:</strong> {{filme.fichaTecnica.bilheteria}}</p>

      <button class="uk-modal-close-default" type="button" uk-close></button>
    </div>
  </div>
{{/if}}